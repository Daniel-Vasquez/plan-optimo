# =============================================================================
# TrackFit — variables de entorno
#
# Copia este archivo a `.env` y rellena los valores reales:
#     cp .env.example .env
#
# `.env` está en .gitignore y NUNCA debe subirse al repositorio.
# Las mismas variables deben cargarse en Vercel:
#     Project → Settings → Environment Variables (Production + Preview)
# =============================================================================


# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# Cadena de conexión de MongoDB Atlas.
# Atlas → Database → Connect → Drivers → Node.js.
# Sustituye <usuario> y <password> por los del usuario de base de datos
# (Atlas → Database Access), no por los de tu cuenta de Atlas.
#
# Si la contraseña lleva caracteres especiales (@ : / ? # [ ] %), hay que
# codificarlos en porcentaje. Lo más simple es generar una sin ellos.
#
# En Atlas → Network Access hay que permitir 0.0.0.0/0: Vercel despliega desde
# IPs dinámicas y no hay un rango fijo que autorizar.
MONGODB_URI="mongodb+srv://<usuario>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=trackfit"

# Nombre de la base de datos dentro del cluster. Se crea sola al primer escribir.
# Conviene usar una distinta en desarrollo y en producción.
MONGODB_DB="trackfit"


# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------
# Clave con la que se firman las cookies de sesión y los tokens.
# Mínimo 32 caracteres aleatorios. Genérala con:
#     openssl rand -base64 32
#
# Debe ser DISTINTA entre desarrollo y producción. Si la cambias, todas las
# sesiones abiertas se invalidan (los usuarios tendrán que volver a entrar).
BETTER_AUTH_SECRET=""

# URL base donde corre la aplicación, sin barra final.
# Desarrollo:  http://localhost:4321
# Producción:  https://tu-proyecto.vercel.app  (o tu dominio propio)
#
# Tiene que coincidir exactamente con el origen desde el que se sirve la app:
# es lo que Better Auth usa para construir los callbacks y validar el origen.
#
# En los despliegues de preview de Vercel no hace falta tocarla: el código ya
# autoriza VERCEL_URL y VERCEL_PROJECT_PRODUCTION_URL, que Vercel inyecta sola.
#
# Ninguna variable de este archivo lleva prefijo PUBLIC_, y es deliberado:
# todas son secretos o configuración de servidor. El prefijo PUBLIC_ las
# enviaría al navegador.
BETTER_AUTH_URL="http://localhost:4321"
