---
import Layout from "../layouts/Layout.astro";
import Toast from "../components/Toast.astro";
import WaterCard from "../components/water/WaterCard.astro";
import AdviceList from "../components/AdviceList.astro";
import Icon from "../components/nav/Icon.astro";
import { getProfile } from "../lib/db/repos/profiles";
import { getAttendanceRange } from "../lib/db/repos/attendance";
import { getWaterDay } from "../lib/db/repos/water";
import { getNutritionDay } from "../lib/db/repos/nutrition";
import { listStrengthSessions } from "../lib/db/repos/strength";
import { listRuns } from "../lib/db/repos/running";
import { listBodyMetrics } from "../lib/db/repos/body";
import { evaluateAutoregulation } from "../lib/autoregulation";
import { adherenceOf, attendanceStreak } from "../lib/attendance";
import { planWeekFor, todayInTimezone, toDateStr, parseDateStr } from "../lib/date";
import { blockLabel, dayPlanFor, isDeloadWeek } from "../lib/strength";
import { waterGoalFor } from "../lib/water";
import { ZERO_MACROS, adherence as macroAdherence, goalsFor } from "../lib/nutrition";

const user = Astro.locals.user!;
const profile = await getProfile(user.id);
const timezone = profile?.timezone ?? "America/Mexico_City";
const today = todayInTimezone(timezone);

const planWeeks = profile?.planWeeks ?? 12;
const planStartDate = profile?.planStartDate ?? today;
const planWeek = planWeekFor(planStartDate, today, planWeeks);
const displayName = profile?.displayName || user.name || user.email;

const dayPlan = dayPlanFor(today);

// Los últimos 28 días alimentan racha y adherencia semanal.
const start = parseDateStr(today);
start.setDate(start.getDate() - 27);
const recentDates: string[] = [];
for (let d = new Date(start); d <= parseDateStr(today); d.setDate(d.getDate() + 1)) {
  recentDates.push(toDateStr(d));
}
const recent = await getAttendanceRange(user.id, recentDates, today, profile);
const streak = attendanceStreak(recent, today);

const weekDates = recentDates.slice(-7);
const weekAdherence = adherenceOf(recent.filter((d) => weekDates.includes(d.date)));

const [waterDay, nutritionDay, strengthSessions] = await Promise.all([
  getWaterDay(user.id, today),
  getNutritionDay(user.id, today),
  listStrengthSessions(user.id, 1),
]);

const waterGoalMl = waterGoalFor(profile, today);
const macroGoals = goalsFor(profile, today);
const macroTotals = nutritionDay?.totals ?? ZERO_MACROS;
const macroPct = macroAdherence(macroTotals, macroGoals);

const [recentRuns, bodyMetrics] = await Promise.all([
  listRuns(user.id, 60),
  listBodyMetrics(user.id, 120),
]);

const todaySession = strengthSessions.find((s) => s.date === today) ?? null;

// Las reglas de rutina.md §4D se evalúan contra los datos reales y se muestran
// el día que aplican.
const advice = evaluateAutoregulation({
  date: today,
  runs: recentRuns,
  strength: strengthSessions,
  body: [...bodyMetrics].reverse(),
  sleepHoursToday: todaySession?.sleepHours ?? null,
});
const sessionDone = (todaySession?.sessionCompletionPct ?? 0) > 0;

const hour = Number(
  new Intl.DateTimeFormat("es-MX", { hour: "numeric", hour12: false, timeZone: timezone })
    .format(new Date()),
);
const greeting = hour < 12 ? "Buenos días" : hour < 18 ? "Buenas tardes" : "Buenas noches";

const dateLabel = new Intl.DateTimeFormat("es-MX", {
  weekday: "long", day: "numeric", month: "long",
}).format(new Date(`${today}T00:00:00`));

// A dónde lleva el botón principal, según lo que toque hoy.
const CTA: Record<string, { href: string; text: string }> = {
  strength: { href: "/fuerza", text: "Registrar la sesión" },
  running: { href: "/running/nueva", text: "Registrar la carrera" },
  volleyball: { href: "/hidratacion", text: "Registrar hidratación" },
  walk: { href: "/nutricion", text: "Registrar la comida" },
  rest: { href: "/nutricion", text: "Registrar la comida" },
};
const cta = CTA[dayPlan.kind]!;
---

<Layout title="Inicio" currentPage="inicio">
  <Toast />
  <div class="mx-auto max-w-4xl space-y-4 px-4 py-6 lg:px-8 lg:py-8">
    <!-- Hoy -->
    <section>
      <p class="text-sm text-muted">{greeting}, {displayName}</p>
      <h1 class="mt-0.5 text-lg font-semibold capitalize text-primary">{dateLabel}</h1>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-surface2 px-3 py-1 text-xs text-muted">
          Semana {planWeek} · {blockLabel(planWeek)}
        </span>
        {
          isDeloadWeek(planWeek) && (
            <span class="rounded-full border border-orange/30 bg-orange/15 px-3 py-1 text-xs text-orange">
              Semana de descarga
            </span>
          )
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="font-display text-3xl text-yellow">{dayPlan.label.toUpperCase()}</span>
        {
          sessionDone && (
            <span class="flex items-center gap-1 text-sm text-yellow">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              {todaySession!.sessionCompletionPct}% completada
            </span>
          )
        }
      </div>
      <p class="mt-1 text-sm text-muted">{dayPlan.detail}</p>

      <a href={cta.href}
        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-yellow px-5 py-3 text-sm font-bold text-ink transition-all hover:opacity-90 active:scale-95">
        {cta.text}
      </a>
    </section>

    <AdviceList advice={advice} />

    <!-- Métricas del plan -->
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {
        [
          { label: "Racha", value: String(streak), unit: streak === 1 ? "día" : "días" },
          { label: "Esta semana", value: `${weekAdherence.pct}%`, unit: `${weekAdherence.completed}/${weekAdherence.required}` },
          { label: "Proteína hoy", value: String(macroTotals.proteinG), unit: `de ${macroGoals.proteinG} g` },
          { label: "Semana del plan", value: `${planWeek}`, unit: `de ${planWeeks}` },
        ].map((metric) => (
          <div class="rounded-xl border border-border bg-surface p-4">
            <p class="text-xs uppercase tracking-wider text-muted">{metric.label}</p>
            <p class="mt-1 text-2xl font-bold text-primary">
              {metric.value}
              <span class="ml-1 text-sm font-normal text-muted">{metric.unit}</span>
            </p>
          </div>
        ))
      }
    </div>

    <WaterCard totalMl={waterDay?.totalMl ?? 0} goalMl={waterGoalMl} date={today} />

    <!-- Macros de hoy, resumidos -->
    <section class="rounded-xl border border-border bg-surface p-4">
      <div class="mb-3 flex items-center justify-between gap-2">
        <a href="/nutricion" class="flex items-center gap-2 text-xs uppercase tracking-wider text-muted transition-colors hover:text-primary">
          <Icon name="nutricion" class="w-4 h-4 text-yellow" />
          Nutrición
        </a>
        <span class="text-xs tabular-nums text-muted">
          <strong class="text-primary">{macroTotals.kcal}</strong> / {macroGoals.kcal} kcal
        </span>
      </div>
      <div class="grid grid-cols-3 gap-3">
        {
          [
            { label: "Proteína", value: macroTotals.proteinG, goal: macroGoals.proteinG, pct: macroPct.proteinG, color: "bg-yellow" },
            { label: "Carbos", value: macroTotals.carbsG, goal: macroGoals.carbsG, pct: macroPct.carbsG, color: "bg-[#3b82f6]" },
            { label: "Grasa", value: macroTotals.fatG, goal: macroGoals.fatG, pct: macroPct.fatG, color: "bg-[#059669]" },
          ].map((macro) => (
            <div>
              <div class="flex items-baseline justify-between text-xs">
                <span class="text-muted">{macro.label}</span>
                <span class="tabular-nums text-muted2">{macro.value}/{macro.goal}</span>
              </div>
              <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-surface2">
                <div class:list={["h-full rounded-full", macro.color]} style={`width:${Math.min(100, macro.pct)}%`} />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Semana de un vistazo -->
    <section class="rounded-xl border border-border bg-surface p-4">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-xs uppercase tracking-wider text-muted">Últimos 7 días</h2>
        <span class="flex gap-3">
          <a href="/cuerpo" class="text-xs text-blue hover:underline">Cuerpo</a>
          <a href="/calendario" class="text-xs text-blue hover:underline">Calendario</a>
        </span>
      </div>
      <div class="grid grid-cols-7 gap-1.5">
        {
          recent.slice(-7).map((day) => {
            const label = new Intl.DateTimeFormat("es-MX", { weekday: "narrow" })
              .format(new Date(`${day.date}T00:00:00`));
            const tone =
              day.status === "completed" ? "bg-yellow/20 border-yellow/40 text-primary"
              : day.status === "partial" ? "bg-orange/15 border-orange/40 text-primary"
              : day.status === "missed" ? "bg-surface2 border-border2 text-muted2"
              : "border-border text-muted2";
            return (
              <a href={`/calendario?month=${day.date.slice(0, 7)}`}
                class:list={["flex aspect-square flex-col items-center justify-center rounded-lg border text-xs transition-colors", tone]}
                aria-label={`${day.date}: ${day.plannedLabel}`}>
                <span class="uppercase">{label}</span>
                <span class="tabular-nums">{Number(day.date.slice(-2))}</span>
              </a>
            );
          })
        }
      </div>
    </section>
  </div>
</Layout>
