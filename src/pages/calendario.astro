---
import Layout from "../layouts/Layout.astro";
import MonthGrid from "../components/calendar/MonthGrid.astro";
import { getProfile } from "../lib/db/repos/profiles";
import { getAttendanceRange } from "../lib/db/repos/attendance";
import { adherenceOf, attendanceStreak, daysOfMonth } from "../lib/attendance";
import { todayInTimezone } from "../lib/date";

const user = Astro.locals.user!;
const profile = await getProfile(user.id);
const today = todayInTimezone(profile?.timezone ?? "America/Mexico_City");

// Mes mostrado; por defecto el de hoy.
const monthParam = Astro.url.searchParams.get("month");
const valid = monthParam && /^\d{4}-\d{2}$/.test(monthParam);
const [year, month] = (valid ? monthParam : today.slice(0, 7)).split("-").map(Number);

const dates = daysOfMonth(year!, month!);
const days = await getAttendanceRange(user.id, dates, today, profile);
const adherence = adherenceOf(days);

// La racha mira más atrás que el mes visible: cortarla en el día 1 daría una
// cifra falsa cada primero de mes.
const streakStart = new Date(`${today}T00:00:00`);
streakStart.setDate(streakStart.getDate() - 120);
const streakDates = [];
for (let d = new Date(streakStart); d <= new Date(`${today}T00:00:00`); d.setDate(d.getDate() + 1)) {
  streakDates.push(
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`,
  );
}
const streak = attendanceStreak(
  await getAttendanceRange(user.id, streakDates, today, profile),
  today,
);

const prevMonth = month === 1 ? `${year! - 1}-12` : `${year}-${String(month! - 1).padStart(2, "0")}`;
const nextMonth = month === 12 ? `${year! + 1}-01` : `${year}-${String(month! + 1).padStart(2, "0")}`;
const monthLabel = new Intl.DateTimeFormat("es-MX", { month: "long", year: "numeric" })
  .format(new Date(year!, month! - 1, 1));

const detail = JSON.stringify(Object.fromEntries(days.map((d) => [d.date, d])));
---

<Layout title="Calendario" currentPage="calendario">
  <div class="mx-auto max-w-3xl space-y-4 px-4 py-6 lg:px-8 lg:py-8" id="calendar-root" data-detail={detail}>
    <h1 class="font-display text-3xl text-primary">CALENDARIO</h1>

    <div class="grid grid-cols-3 gap-3">
      {
        [
          { label: "Adherencia", value: `${adherence.pct}%`, sub: `${adherence.completed} de ${adherence.required} días` },
          { label: "Racha", value: String(streak), sub: streak === 1 ? "día" : "días" },
          { label: "Sin registrar", value: String(adherence.missed), sub: "este mes" },
        ].map((stat) => (
          <div class="rounded-xl border border-border2 bg-surface p-3 text-center">
            <p class="text-[11px] uppercase tracking-wider text-muted">{stat.label}</p>
            <p class="font-display text-2xl text-primary">{stat.value}</p>
            <p class="text-[11px] text-muted2">{stat.sub}</p>
          </div>
        ))
      }
    </div>

    <div class="flex items-center justify-between gap-2 rounded-xl border border-border2 bg-surface px-2 py-2">
      <a href={`/calendario?month=${prevMonth}`} aria-label="Mes anterior"
        class="rounded-lg p-2 text-muted transition-colors hover:bg-surface2 hover:text-primary">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          ><polyline points="15 18 9 12 15 6"></polyline></svg>
      </a>
      <p class="text-sm capitalize text-primary">{monthLabel}</p>
      <a href={`/calendario?month=${nextMonth}`} aria-label="Mes siguiente"
        class="rounded-lg p-2 text-muted transition-colors hover:bg-surface2 hover:text-primary">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          ><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </div>

    <MonthGrid days={days} today={today} />

    <!-- Detalle del día: panel bajo la rejilla en vez de un modal, para no
         tapar el calendario mientras se comparan días. -->
    <section id="day-detail" class="hidden rounded-xl border border-border2 bg-surface p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p id="detail-date" class="text-xs capitalize text-muted"></p>
          <h2 id="detail-plan" class="mt-0.5 font-display text-2xl text-primary"></h2>
        </div>
        <span id="detail-status" class="shrink-0 rounded-full px-2.5 py-1 text-xs"></span>
      </div>
      <div id="detail-body" class="mt-4 space-y-2"></div>
      <div id="detail-actions" class="mt-4 flex flex-wrap gap-2"></div>
    </section>
  </div>
</Layout>

<script>
  function init() {
    const root = document.getElementById("calendar-root");
    if (!root) return;

    const detail: Record<string, any> = JSON.parse(root.dataset.detail!);
    const panel = document.getElementById("day-detail")!;

    const STATUS_LABEL: Record<string, { text: string; tone: string }> = {
      completed: { text: "Completado", tone: "bg-yellow/15 text-yellow" },
      partial: { text: "Parcial", tone: "bg-orange/15 text-orange" },
      missed: { text: "Sin registrar", tone: "bg-surface2 text-muted" },
      rest: { text: "Descanso", tone: "bg-surface2 text-muted" },
      future: { text: "Pendiente", tone: "bg-surface2 text-muted" },
    };

    function row(label: string, value: string) {
      return `<div class="flex items-baseline justify-between gap-3 text-sm">
        <span class="text-muted">${label}</span>
        <span class="text-primary tabular-nums">${value}</span>
      </div>`;
    }

    function show(date: string) {
      const day = detail[date];
      if (!day) return;

      document.getElementById("detail-date")!.textContent =
        new Intl.DateTimeFormat("es-MX", { weekday: "long", day: "numeric", month: "long" })
          .format(new Date(`${date}T00:00:00`));
      document.getElementById("detail-plan")!.textContent = day.plannedLabel.toUpperCase();

      const status = STATUS_LABEL[day.status]!;
      const statusEl = document.getElementById("detail-status")!;
      statusEl.textContent = status.text;
      statusEl.className = `shrink-0 rounded-full px-2.5 py-1 text-xs ${status.tone}`;

      const rows: string[] = [];
      if (day.isDeload) {
        rows.push(`<p class="rounded-lg border border-orange/30 bg-orange/10 px-3 py-2 text-xs text-orange">Semana de descarga</p>`);
      }
      if (day.strength) {
        rows.push(row(`Fuerza ${day.strength.templateId}`, `${day.strength.completionPct}% · ${day.strength.volumeKg} kg`));
      }
      if (day.running) rows.push(row("Carrera", `${day.running.distanceKm} km`));
      if (day.water) {
        rows.push(row("Agua", `${(day.water.totalMl / 1000).toFixed(1)} / ${(day.water.goalMl / 1000).toFixed(1)} L`));
      }
      if (day.nutrition) {
        rows.push(row("Proteína", `${day.nutrition.proteinG} / ${day.nutrition.goalProteinG} g`));
      }
      if (rows.length === 0) {
        rows.push(`<p class="text-sm text-muted">Nada registrado este día.</p>`);
      }
      document.getElementById("detail-body")!.innerHTML = rows.join("");

      // Los accesos llevan al módulo que corresponde a ese día, no a una
      // pantalla genérica de "registrar".
      const actions: string[] = [];
      const cls = "rounded-lg bg-surface2 px-3 py-2 text-xs font-semibold text-primary hover:bg-border2";
      if (day.plannedKind === "strength") actions.push(`<a href="/fuerza?date=${date}" class="${cls}">Sesión de fuerza</a>`);
      if (day.plannedKind === "strength" || day.plannedKind === "running") {
        actions.push(`<a href="/running/nueva" class="${cls}">Registrar carrera</a>`);
      }
      actions.push(`<a href="/nutricion?date=${date}" class="${cls}">Nutrición</a>`);
      actions.push(`<a href="/hidratacion" class="${cls}">Agua</a>`);
      document.getElementById("detail-actions")!.innerHTML = actions.join("");

      panel.classList.remove("hidden");
      panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    for (const cell of document.querySelectorAll<HTMLElement>(".day-cell")) {
      cell.addEventListener("click", () => show(cell.dataset.date!));
    }
  }

  document.addEventListener("astro:page-load", init);
</script>
