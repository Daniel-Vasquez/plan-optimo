---
import Layout from "../layouts/Layout.astro";
import Toast from "../components/Toast.astro";
import { listNotes } from "../lib/db/repos/notes";
import { getProfile } from "../lib/db/repos/profiles";
import { todayInTimezone } from "../lib/date";

const user = Astro.locals.user!;
const profile = await getProfile(user.id);
const today = todayInTimezone(profile?.timezone ?? "America/Mexico_City");
const notes = await listNotes(user.id);

const allTags = [...new Set(notes.flatMap((note) => note.tags))].sort();
const dateFmt = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "short" });
---

<Layout title="Notas" currentPage="notas">
  <Toast />
  <div class="mx-auto max-w-3xl space-y-4 px-4 py-6 lg:px-8 lg:py-8" id="notes-root" data-today={today}>
    <div class="flex items-center justify-between gap-3">
      <h1 class="font-display text-3xl text-primary">NOTAS</h1>
      <button id="new-note" type="button"
        class="rounded-lg bg-blue px-4 py-2 text-sm font-bold text-white transition-all hover:opacity-90 active:scale-95">
        Nueva nota
      </button>
    </div>

    <div class="space-y-2">
      <input id="search" type="search" placeholder="Buscar en las notas..."
        class="w-full rounded-lg border border-border2 bg-surface2 px-4 py-2.5 text-primary placeholder:text-muted2 focus:outline-hidden focus:border-blue/50" />
      {
        allTags.length > 0 && (
          <div class="scrollbar-hide flex gap-2 overflow-x-auto pb-1">
            {allTags.map((tag) => (
              <button type="button" class="tag-filter shrink-0 rounded-full bg-surface2 px-3 py-1 text-xs text-muted transition-colors hover:text-primary"
                data-tag={tag}>#{tag}</button>
            ))}
          </div>
        )
      }
    </div>

    <ul id="notes-list" class="space-y-2">
      {
        notes.length === 0 ? (
          <li class="rounded-xl border border-border2 bg-surface p-8 text-center text-sm text-muted">
            Todavía no hay notas. Úsalas como bitácora: cómo te sentiste, qué ajustaste, qué duele.
          </li>
        ) : (
          notes.map((note) => (
            <li>
              <button type="button" class="note-item w-full rounded-xl border border-border2 bg-surface p-4 text-left transition-colors hover:border-border2 hover:bg-surface2"
                data-id={String(note._id)}
                data-date={note.date}
                data-title={note.title}
                data-content={note.content}
                data-tags={note.tags.join(",")}
              >
                <div class="flex items-baseline justify-between gap-3">
                  <h2 class="min-w-0 truncate font-semibold text-primary">{note.title || "Sin título"}</h2>
                  <span class="shrink-0 text-xs text-muted2">
                    {dateFmt.format(new Date(`${note.date}T00:00:00`))}
                  </span>
                </div>
                {note.content && <p class="mt-1 line-clamp-2 text-sm text-muted">{note.content}</p>}
                {note.tags.length > 0 && (
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {note.tags.map((tag) => (
                      <span class="rounded-full bg-surface2 px-2 py-0.5 text-[11px] text-muted2">#{tag}</span>
                    ))}
                  </div>
                )}
              </button>
            </li>
          ))
        )
      }
    </ul>
  </div>

  <div id="note-editor" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs">
    <div class="absolute inset-x-0 bottom-0 flex max-h-[90vh] flex-col rounded-t-2xl border-t border-border2 bg-surface md:inset-x-auto md:top-1/2 md:left-1/2 md:max-h-[80vh] md:w-full md:max-w-lg md:-translate-x-1/2 md:-translate-y-1/2 md:rounded-2xl md:border">
      <div class="flex items-center gap-2 border-b border-border p-4">
        <input id="editor-title" type="text" maxlength="120" placeholder="Título"
          class="min-w-0 flex-1 bg-transparent text-lg font-semibold text-primary placeholder:text-muted2 focus:outline-hidden" />
        <button id="editor-close" type="button" aria-label="Cerrar"
          class="shrink-0 rounded-lg p-2 text-muted hover:bg-surface2 hover:text-primary">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="flex-1 overflow-y-auto p-4">
        <textarea id="editor-content" rows="10" placeholder="Escribe aquí..."
          class="w-full resize-none bg-transparent text-sm leading-relaxed text-primary placeholder:text-muted2 focus:outline-hidden"></textarea>
      </div>

      <div class="space-y-3 border-t border-border p-4">
        <div class="grid grid-cols-2 gap-3">
          <input id="editor-date" type="date"
            class="w-full rounded-lg border border-border2 bg-surface2 px-3 py-2 text-sm text-primary focus:outline-hidden focus:border-blue/50" />
          <input id="editor-tags" type="text" placeholder="etiquetas, separadas, así"
            class="w-full rounded-lg border border-border2 bg-surface2 px-3 py-2 text-sm text-primary placeholder:text-muted2 focus:outline-hidden focus:border-blue/50" />
        </div>
        <div class="flex gap-2">
          <button id="editor-delete" type="button"
            class="hidden rounded-lg border border-orange/30 px-4 py-2.5 text-sm font-semibold text-orange hover:bg-orange/10">
            Eliminar
          </button>
          <button id="editor-save" type="button"
            class="flex-1 rounded-lg bg-blue py-2.5 text-sm font-bold text-white transition-all hover:opacity-90 active:scale-95">
            Guardar
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function init() {
    const root = document.getElementById("notes-root");
    if (!root) return;

    const editor = document.getElementById("note-editor")!;
    const title = document.getElementById("editor-title") as HTMLInputElement;
    const content = document.getElementById("editor-content") as HTMLTextAreaElement;
    const dateInput = document.getElementById("editor-date") as HTMLInputElement;
    const tagsInput = document.getElementById("editor-tags") as HTMLInputElement;
    const deleteBtn = document.getElementById("editor-delete") as HTMLButtonElement;

    let editingId: string | null = null;

    function open(note?: { id: string; date: string; title: string; content: string; tags: string }) {
      editingId = note?.id ?? null;
      title.value = note?.title ?? "";
      content.value = note?.content ?? "";
      dateInput.value = note?.date ?? root!.dataset.today!;
      tagsInput.value = note?.tags ?? "";
      deleteBtn.classList.toggle("hidden", !editingId);
      editor.classList.remove("hidden");
      title.focus();
    }

    function close() {
      editor.classList.add("hidden");
      editingId = null;
    }

    document.getElementById("new-note")!.addEventListener("click", () => open());
    document.getElementById("editor-close")!.addEventListener("click", close);
    editor.addEventListener("click", (event) => {
      if (event.target === editor) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !editor.classList.contains("hidden")) close();
    });

    for (const item of document.querySelectorAll<HTMLElement>(".note-item")) {
      item.addEventListener("click", () =>
        open({
          id: item.dataset.id!,
          date: item.dataset.date!,
          title: item.dataset.title!,
          content: item.dataset.content!,
          tags: item.dataset.tags!,
        }),
      );
    }

    document.getElementById("editor-save")!.addEventListener("click", async () => {
      if (!title.value.trim() && !content.value.trim()) {
        window.showToast?.("Escribe algo antes de guardar", "error");
        return;
      }

      const response = await fetch("/api/notes", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          id: editingId,
          date: dateInput.value,
          title: title.value,
          content: content.value,
          tags: tagsInput.value.split(",").map((tag) => tag.trim()).filter(Boolean),
        }),
      });

      if (!response.ok) {
        window.showToast?.("No se pudo guardar", "error");
        return;
      }
      window.showToast?.("Nota guardada");
      setTimeout(() => window.location.reload(), 600);
    });

    let armed = false;
    deleteBtn.addEventListener("click", async () => {
      // Doble pulsación en vez de window.confirm(), que bloquea el hilo.
      if (!armed) {
        armed = true;
        deleteBtn.textContent = "¿Seguro?";
        setTimeout(() => {
          armed = false;
          deleteBtn.textContent = "Eliminar";
        }, 3000);
        return;
      }
      await fetch(`/api/notes?id=${encodeURIComponent(editingId!)}`, { method: "DELETE" });
      window.location.reload();
    });

    // Filtrado en cliente: con las notas ya renderizadas, ir al servidor por
    // cada tecla sería más lento y no aportaría nada.
    const search = document.getElementById("search") as HTMLInputElement;
    let activeTag: string | null = null;

    function applyFilters() {
      const term = search.value.trim().toLowerCase();
      for (const item of document.querySelectorAll<HTMLElement>(".note-item")) {
        const haystack = `${item.dataset.title} ${item.dataset.content}`.toLowerCase();
        const tags = (item.dataset.tags ?? "").split(",").filter(Boolean);
        const matches = (!term || haystack.includes(term)) && (!activeTag || tags.includes(activeTag));
        item.closest("li")!.classList.toggle("hidden", !matches);
      }
    }

    search.addEventListener("input", applyFilters);

    for (const button of document.querySelectorAll<HTMLElement>(".tag-filter")) {
      button.addEventListener("click", () => {
        const tag = button.dataset.tag!;
        activeTag = activeTag === tag ? null : tag;
        for (const other of document.querySelectorAll<HTMLElement>(".tag-filter")) {
          const on = other.dataset.tag === activeTag;
          other.classList.toggle("bg-blue", on);
          other.classList.toggle("text-white", on);
          other.classList.toggle("bg-surface2", !on);
          other.classList.toggle("text-muted", !on);
        }
        applyFilters();
      });
    }
  }

  document.addEventListener("astro:page-load", init);
</script>
