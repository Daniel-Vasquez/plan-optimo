---
import Layout from "../../layouts/Layout.astro";
import { getProfile } from "../../lib/db/repos/profiles";
import { EXERCISE_CATALOG, listStrengthSessions } from "../../lib/db/repos/strength";
import { exerciseProgress } from "../../lib/strength";
import { formatLoad, repRange } from "../../lib/units";
import { DENSIFICATION_LADDER } from "../../data/plan";

const user = Astro.locals.user!;
const { slug } = Astro.params;

const exercise = EXERCISE_CATALOG.find((e) => e.slug === slug);
if (!exercise) return Astro.redirect("/progreso-fuerza");

const profile = await getProfile(user.id);
const unit = profile?.displayUnit ?? "lb";

const sessions = await listStrengthSessions(user.id, 200);
const history = exerciseProgress([...sessions].reverse(), exercise.slug);

// Peldaño actual: el de la sesión más reciente que registró este ejercicio.
const latest = [...sessions].find((s) => s.exercises.some((e) => e.slug === exercise.slug));
const currentStep =
  latest?.exercises.find((e) => e.slug === exercise.slug)?.densificationStep ?? 1;

const best = history.length
  ? {
      reps: Math.max(...history.map((h) => h.totalReps)),
      volume: Math.max(...history.map((h) => h.volumeKg)),
      e1rm: Math.max(...history.map((h) => h.e1rmKg ?? 0)),
    }
  : null;

const dateFmt = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "short" });
---

<Layout title={exercise.name} currentPage="fuerza">
  <div class="mx-auto max-w-2xl space-y-5 px-4 py-6 lg:px-8 lg:py-8">
    <a href="/progreso-fuerza" class="inline-flex items-center gap-1 text-xs text-muted transition-colors hover:text-primary">
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        ><polyline points="15 18 9 12 15 6"></polyline></svg>
      Progreso de fuerza
    </a>

    <div>
      <p class="text-xs text-muted">Fuerza {exercise.templateId} · {exercise.sessionLabel}</p>
      <h1 class="mt-1 font-display text-3xl text-primary">{exercise.name.toUpperCase()}</h1>
    </div>

    <section class="rounded-xl border border-border2 bg-surface p-6">
      <h2 class="mb-3 text-sm font-semibold text-primary">Prescripción</h2>
      <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {
          [
            { label: "Series × reps", value: `${exercise.sets} × ${repRange(exercise)}` },
            { label: "RIR objetivo", value: String(exercise.targetRir) },
            { label: "Descanso", value: exercise.restSeconds > 0 ? `${exercise.restSeconds}"` : "Superserie" },
            { label: "Carga inicial", value: exercise.startLoadKg === null ? "Peso corporal" : `${formatLoad(exercise.startLoadKg, unit)}${exercise.loadMode === "perHand" ? " ×2" : ""}` },
          ].map((item) => (
            <div>
              <p class="mb-1 text-xs uppercase tracking-wider text-muted">{item.label}</p>
              <p class="font-semibold text-primary">{item.value}</p>
            </div>
          ))
        }
      </div>
      {exercise.tempo && (
        <p class="mt-4 text-sm text-muted">
          <span class="text-xs uppercase tracking-wider text-muted2">Tempo</span> {exercise.tempo}
        </p>
      )}
      <p class="mt-3 text-sm leading-relaxed text-muted">{exercise.cue}</p>
    </section>

    <section class="rounded-xl border border-border2 bg-surface p-6">
      <h2 class="mb-1 text-sm font-semibold text-primary">Peldaño actual</h2>
      <p class="text-xs text-muted">
        {currentStep}. {DENSIFICATION_LADDER[currentStep - 1]!.method}
      </p>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        {DENSIFICATION_LADDER[currentStep - 1]!.how}
      </p>
    </section>

    {
      best && (
        <section class="rounded-xl border border-border2 bg-surface p-6">
          <h2 class="mb-4 text-sm font-semibold text-primary">Mejores marcas</h2>
          <div class="grid grid-cols-3 gap-4">
            <div>
              <p class="mb-1 text-xs uppercase tracking-wider text-muted">Más reps</p>
              <p class="text-xl font-bold text-primary">{best.reps}</p>
            </div>
            <div>
              <p class="mb-1 text-xs uppercase tracking-wider text-muted">Más volumen</p>
              <p class="text-xl font-bold text-primary">
                {formatLoad(best.volume, unit, false)}
                <span class="ml-1 text-sm font-normal text-muted">{unit}</span>
              </p>
            </div>
            <div>
              <p class="mb-1 text-xs uppercase tracking-wider text-muted">1RM estimado</p>
              <p class="text-xl font-bold text-primary">
                {best.e1rm ? formatLoad(best.e1rm, unit, false) : "—"}
                {best.e1rm ? <span class="ml-1 text-sm font-normal text-muted">{unit}</span> : null}
              </p>
            </div>
          </div>
        </section>
      )
    }

    <section class="rounded-xl border border-border2 bg-surface p-6">
      <h2 class="mb-4 text-sm font-semibold text-primary">Historial</h2>
      {
        history.length === 0 ? (
          <p class="py-6 text-center text-sm text-muted">
            Aún no has registrado este ejercicio.
          </p>
        ) : (
          <div class="-mx-2 overflow-x-auto px-2">
            <table class="w-full min-w-[380px] text-sm">
              <thead>
                <tr class="border-b border-border text-left text-xs uppercase tracking-wider text-muted">
                  <th class="pb-2 font-medium">Fecha</th>
                  <th class="pb-2 text-right font-medium">Reps</th>
                  <th class="pb-2 text-right font-medium">Peso</th>
                  <th class="pb-2 text-right font-medium">Volumen</th>
                  <th class="pb-2 text-right font-medium">1RM est.</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {[...history].reverse().map((point) => (
                  <tr>
                    <td class="py-2.5 text-muted">
                      {dateFmt.format(new Date(`${point.date}T00:00:00`))}
                    </td>
                    <td class="py-2.5 text-right tabular-nums text-primary">{point.totalReps}</td>
                    <td class="py-2.5 text-right tabular-nums text-muted">
                      {point.loadKg ? formatLoad(point.loadKg, unit) : "—"}
                    </td>
                    <td class="py-2.5 text-right tabular-nums text-muted">
                      {formatLoad(point.volumeKg, unit, false)} {unit}
                    </td>
                    <td class="py-2.5 text-right tabular-nums text-muted">
                      {point.e1rmKg ? formatLoad(point.e1rmKg, unit) : "—"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
  </div>
</Layout>
