---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import TopNav from "../components/nav/TopNav.astro";
import BottomNav from "../components/nav/BottomNav.astro";
import { getProfile } from "../lib/db/repos/profiles";
import { getWaterDay } from "../lib/db/repos/water";
import { planWeekFor, todayInTimezone } from "../lib/date";
import { waterGoalFor, waterPct } from "../lib/water";

export interface Props {
  title?: string;
  currentPage?: string;
}
const { title = "TrackFit", currentPage = "" } = Astro.props;

// Todas las páginas que usan este layout son privadas, así que el middleware
// garantiza que hay usuario. El perfil puede faltar un instante entre el alta
// y la siembra, de ahí los valores de respaldo.
const user = Astro.locals.user!;
const profile = await getProfile(user.id);

const planWeeks = profile?.planWeeks ?? 12;
const weekBadge = profile
  ? `Sem ${planWeekFor(profile.planStartDate, todayInTimezone(profile.timezone), planWeeks)}/${planWeeks}`
  : "";
const displayName = profile?.displayName || user.name || user.email;

// Indicador de agua siempre visible: el registro de hidratación se abandona si
// hay que entrar en una pantalla concreta para saber cómo se va.
const today = todayInTimezone(profile?.timezone ?? "America/Mexico_City");
const waterDay = await getWaterDay(user.id, today);
const waterPercent = profile
  ? waterPct(waterDay?.totalMl ?? 0, waterGoalFor(profile, today))
  : null;
---

<!doctype html>
<html lang="es" class="bg-base text-primary font-body">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Se aplica el tema ANTES de pintar. Si esto se moviera a un módulo
      // normal, la página se vería blanca un instante antes de oscurecerse.
      (function () {
        function getTheme() {
          try {
            return localStorage.getItem("trackfit_theme") === "light"
              ? "light"
              : "dark";
          } catch (_) {
            return "dark";
          }
        }
        function applyTheme(theme) {
          document.documentElement.classList.toggle("light", theme === "light");
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta)
            meta.setAttribute(
              "content",
              theme === "light" ? "#f1f3f8" : "#0d0f14",
            );
        }
        window.setTheme = function (theme) {
          try {
            localStorage.setItem("trackfit_theme", theme);
          } catch (_) {}
          applyTheme(theme);
        };
        window.toggleTheme = function () {
          window.setTheme(getTheme() === "light" ? "dark" : "light");
        };
        applyTheme(getTheme());
        // Las View Transitions reemplazan el <html>, así que hay que reaplicar.
        document.addEventListener("astro:after-swap", function () {
          applyTheme(getTheme());
        });
      })();
    </script>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>{title} · TrackFit</title>
    <link rel="icon" type="image/svg+xml" href="/avatar-batman.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0d0f14" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="TrackFit" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="bg-base min-h-screen font-body">
    <TopNav
      currentPage={currentPage}
      userName={displayName}
      userEmail={user.email}
      weekBadge={weekBadge}
      waterPct={waterPercent}
    />

    {/* Arriba se compensa la barra fija; abajo, la de móvil, para que no
        tape el final del contenido ni los botones de acción. */}
    <main class="pt-14 pb-20 md:pb-0 lg:pt-16">
      <div class="mx-auto max-w-7xl">
        <slot />
      </div>
    </main>

    <BottomNav currentPage={currentPage} />
  </body>
</html>
