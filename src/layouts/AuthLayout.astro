---
import "../styles/global.css";

export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-base text-primary font-body">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Mismo anti-flash de tema que el layout principal: se aplica antes de
      // pintar para que no haya un fogonazo blanco al cargar en tema oscuro.
      (function () {
        try {
          var theme = localStorage.getItem("trackfit_theme");
          document.documentElement.classList.toggle("light", theme === "light");
        } catch (_) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} · TrackFit</title>
    <link rel="icon" type="image/svg+xml" href="/avatar-batman.svg" />
    <meta name="theme-color" content="#0d0f14" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-base min-h-screen font-body flex items-center justify-center p-4">
    <main class="w-full max-w-sm">
      <div class="text-center mb-8">
        <span class="font-display text-5xl text-yellow tracking-wider">TRACKFIT</span>
        <p class="text-muted text-sm mt-1">Fuerza · Running · Nutrición</p>
      </div>
      <slot />
    </main>
  </body>
</html>
