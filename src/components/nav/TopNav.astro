---
import NavLink from './NavLink.astro';
import UserMenu from './UserMenu.astro';
import Icon from './Icon.astro';
import { NAV_DESTINATIONS } from './destinations';

/**
 * Barra de navegación fija superior.
 *
 * Queda fija arriba y visible SIEMPRE, sin reaccionar al desplazamiento: es
 * donde viven la identidad, la semana del plan, el agua y la cuenta, y son
 * datos que deben poder consultarse en cualquier momento.
 *
 * En móvil no muestra los destinos: ahí los sirve `BottomNav`, al alcance del
 * pulgar. La lista sale de `destinations.ts` para que ambas barras no puedan
 * desincronizarse.
 */
export interface Props {
  currentPage?: string;
  userName: string;
  userEmail: string;
  weekBadge?: string;
  /** Porcentaje de la meta de agua de hoy; null si aún no hay perfil. */
  waterPct?: number | null;
}

const {
  currentPage = '',
  userName,
  userEmail,
  weekBadge = '',
  waterPct = null,
} = Astro.props;

---

<header
  class="fixed top-0 right-0 left-0 z-50 h-14 border-b border-border bg-surface lg:h-16"
>
  <div class="mx-auto flex h-full max-w-7xl items-center gap-2 px-3 lg:gap-4 lg:px-6">
    <a
      href="/"
      class="shrink-0 font-display text-2xl tracking-wider text-yellow lg:text-3xl"
      aria-label="TrackFit, ir al inicio"
    >
      TRACKFIT
    </a>

    <nav
      aria-label="Navegación principal"
      class="scrollbar-hide hidden min-w-0 flex-1 items-center gap-0.5 overflow-x-auto md:flex lg:justify-center lg:gap-1"
    >
      {
        NAV_DESTINATIONS.map((d) => (
          <NavLink href={d.href} label={d.label} icon={d.icon} current={currentPage === d.id} />
        ))
      }
    </nav>

    {/* En móvil no hay tira de destinos: este hueco empuja los controles a la derecha. */}
    <div class="flex-1 md:hidden"></div>

    <div class="flex shrink-0 items-center gap-1">
      {weekBadge && (
        <span
          class="hidden rounded-full bg-surface2 px-2.5 py-1 text-xs text-muted lg:inline"
          >{weekBadge}</span
        >
      )}

      {
        waterPct !== null && (
          <a
            href="/hidratacion"
            aria-label={`Hidratación: ${waterPct}% de la meta de hoy`}
            class="flex items-center gap-1 rounded-lg px-1.5 py-1.5 text-muted transition-colors hover:bg-surface2 hover:text-blue"
          >
            <Icon name="agua" class="w-4 h-4 text-blue" />
            <span id="nav-water-pct" class="text-xs tabular-nums">{waterPct}%</span>
          </a>
        )
      }

      <button
        type="button"
        onclick="toggleTheme()"
        aria-label="Cambiar tema"
        class="theme-toggle-btn rounded-lg p-1.5 text-muted transition-colors hover:bg-surface2 hover:text-primary"
      >
        <Icon name="sol" class="icon-sun w-5 h-5" />
        <Icon name="luna" class="icon-moon w-5 h-5" />
      </button>

      <UserMenu name={userName} email={userEmail} weekBadge={weekBadge} />
    </div>
  </div>
</header>
