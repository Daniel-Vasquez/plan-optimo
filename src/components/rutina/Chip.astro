---
/**
 * Etiqueta para un dato puntual: series, reps, descanso, tempo.
 *
 * Los tonos son semánticos y no decorativos: `accent` marca lo que el
 * documento señala como prioritario, y `warn` lo que es una advertencia.
 */
export interface Props {
  tone?: 'neutral' | 'accent' | 'info' | 'warn';
  label?: string;
}

const { tone = 'neutral', label } = Astro.props;

const TONES = {
  neutral: 'bg-surface2 text-muted',
  accent: 'bg-yellow/15 text-yellow border border-yellow/30',
  info: 'bg-blue/15 text-blue border border-blue/30',
  warn: 'bg-orange/15 text-orange border border-orange/30',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs whitespace-nowrap',
    TONES[tone],
  ]}
>
  {label && <span class="text-[10px] uppercase tracking-wider opacity-70">{label}</span>}
  <slot />
</span>
