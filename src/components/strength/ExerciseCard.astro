---
import { DENSIFICATION_LADDER } from '../../data/plan';
import type { StrengthExercise, WeightUnit } from '../../types/models';
import { formatLoad, repRange } from '../../lib/units';

/**
 * Un ejercicio dentro de la sesión.
 *
 * La rejilla de series es lo central: cada fila muestra lo REALIZADO junto a lo
 * asignado en gris. Comparar es el objetivo del módulo, y obligar a recordar lo
 * prescrito mientras se entrena lo haría inútil.
 */
export interface Props {
  exercise: StrengthExercise;
  unit: WeightUnit;
  cue: string;
}

const { exercise, unit, cue } = Astro.props;
const { assigned } = exercise;

const ladderStep = DENSIFICATION_LADDER[exercise.densificationStep - 1]!;
---

<article
  class="exercise-card rounded-xl border border-border2 bg-surface"
  data-slug={exercise.slug}
  data-rest={String(assigned.restSeconds)}
  data-step={String(exercise.densificationStep)}
>
  <header class="border-b border-border p-4">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h3 class="font-semibold text-primary">
          {exercise.supersetGroup && (
            <span class="mr-1 rounded bg-surface2 px-1.5 py-0.5 text-[11px] text-muted">
              {exercise.supersetGroup}{exercise.order % 2 === 1 ? 'A' : 'B'}
            </span>
          )}
          {exercise.name}
        </h3>
        <p class="mt-1 text-xs text-muted">
          {assigned.sets} × {repRange(assigned)} · RIR {assigned.targetRir}
          {assigned.restSeconds > 0 && ` · ${assigned.restSeconds}"`}
          {assigned.tempo && ` · tempo ${assigned.tempo}`}
          {assigned.loadKg !== null && ` · ${formatLoad(assigned.loadKg, unit)}${assigned.loadMode === 'perHand' ? ' ×2' : ''}`}
        </p>
      </div>
      <span
        class="ex-pct shrink-0 rounded-full bg-surface2 px-2 py-1 text-xs tabular-nums text-muted"
      >{exercise.completionPct}%</span>
    </div>

    <details class="mt-2">
      <summary class="cursor-pointer list-none text-[11px] text-muted2 hover:text-muted">
        Técnica y progresión
      </summary>
      <p class="mt-2 text-xs leading-relaxed text-muted">{cue}</p>
      <div class="mt-2 rounded-lg bg-surface2 p-2.5">
        <label class="block text-[11px] uppercase tracking-wider text-muted2" for={`step-${exercise.slug}`}>
          Peldaño de densificación
        </label>
        <select
          id={`step-${exercise.slug}`}
          class="ex-step mt-1 w-full rounded border border-border2 bg-surface px-2 py-1.5 text-xs text-primary focus:outline-hidden focus:border-yellow"
        >
          {DENSIFICATION_LADDER.map((rung) => (
            <option value={rung.step} selected={rung.step === exercise.densificationStep}>
              {rung.step}. {rung.method}
            </option>
          ))}
        </select>
        <p class="ex-step-how mt-1.5 text-[11px] leading-relaxed text-muted2">{ladderStep.how}</p>
      </div>
    </details>
  </header>

  <div class="p-4">
    <div class="mb-2 grid grid-cols-[1.5rem_1fr_1fr_3rem_2.25rem] items-center gap-2 text-[11px] uppercase tracking-wider text-muted2">
      <span>#</span>
      <span>Reps</span>
      <span>{unit === 'lb' ? 'Peso (lb)' : 'Peso (kg)'}</span>
      <span>RIR</span>
      <span class="text-right">Ok</span>
    </div>

    <div class="space-y-2">
      {
        exercise.sets.map((set) => (
          <div class="set-row grid grid-cols-[1.5rem_1fr_1fr_3rem_2.25rem] items-center gap-2" data-index={set.index}>
            <span class="text-xs tabular-nums text-muted2">{set.index}</span>

            <input
              type="number" min="0" max="200" inputmode="numeric"
              class="set-reps w-full rounded-lg border border-border2 bg-surface2 px-2 py-2 text-sm tabular-nums text-primary placeholder:text-muted2 focus:outline-hidden focus:border-yellow"
              placeholder={String(assigned.repMin)}
              value={set.reps ?? ''}
            />

            <input
              type="number" min="0" max="500" step="0.5" inputmode="decimal"
              class="set-load w-full rounded-lg border border-border2 bg-surface2 px-2 py-2 text-sm tabular-nums text-primary placeholder:text-muted2 focus:outline-hidden focus:border-yellow"
              placeholder={assigned.loadKg === null ? '—' : formatLoad(assigned.loadKg, unit, false)}
              value={set.loadKg === null ? '' : formatLoad(set.loadKg, unit, false)}
            />

            <input
              type="number" min="0" max="10" inputmode="numeric"
              class="set-rir w-full rounded-lg border border-border2 bg-surface2 px-1.5 py-2 text-sm tabular-nums text-primary placeholder:text-muted2 focus:outline-hidden focus:border-yellow"
              placeholder={String(assigned.targetRir)}
              value={set.rir ?? ''}
            />

            <button
              type="button"
              class="set-done flex h-9 w-9 items-center justify-center rounded-lg border transition-colors"
              class:list={[set.completed ? 'border-yellow bg-yellow text-ink' : 'border-border2 text-muted2 hover:text-primary']}
              aria-pressed={set.completed}
              aria-label={`Marcar la serie ${set.index} como hecha`}
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </button>
          </div>
        ))
      }
    </div>

    <p class="ex-maxed mt-3 hidden rounded-lg border border-yellow/30 bg-yellow/10 px-3 py-2 text-xs text-yellow">
      Peso maxeado: todas las series al tope del rango con el RIR objetivo. Toca subir un peldaño.
    </p>
  </div>
</article>
