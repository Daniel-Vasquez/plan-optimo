---
import Icon, { type IconName } from './nav/Icon.astro';

/**
 * Marcador para los módulos que la navegación ya enlaza pero que todavía no
 * están construidos.
 *
 * Es preferible a dejar que el enlace dé 404, y a esconder el destino hasta
 * que exista: la barra queda completa desde el principio y cada página dice
 * en qué tanda llega y qué va a hacer.
 */
export interface Props {
  title: string;
  icon: IconName;
  tanda: number;
  description: string;
  features: string[];
  /** Ruta provisional que ya ofrece parte de esto, si la hay. */
  legacyHref?: string;
  legacyLabel?: string;
}

const { title, icon, tanda, description, features, legacyHref, legacyLabel } = Astro.props;
---

<div class="mx-auto max-w-2xl px-4 py-10 lg:px-8 lg:py-16">
  <div class="rounded-2xl border border-border2 bg-surface p-8 text-center">
    <div
      class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-surface2 text-muted"
    >
      <Icon name={icon} class="w-7 h-7" />
    </div>

    <h1 class="font-display text-3xl tracking-wide text-primary">{title.toUpperCase()}</h1>
    <p
      class="mt-2 inline-block rounded-full bg-surface2 px-3 py-1 text-xs text-muted"
    >
      Llega en la Tanda {tanda}
    </p>

    <p class="mx-auto mt-5 max-w-md text-sm leading-relaxed text-muted">{description}</p>

    <ul class="mx-auto mt-6 max-w-sm space-y-2 text-left">
      {
        features.map((feature) => (
          <li class="flex items-start gap-2.5 text-sm text-muted">
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-muted2" aria-hidden="true" />
            {feature}
          </li>
        ))
      }
    </ul>

    {
      legacyHref && (
        <p class="mx-auto mt-6 max-w-md rounded-lg border border-border bg-surface2 px-4 py-3 text-sm text-muted">
          Mientras tanto, <a href={legacyHref} class="text-blue hover:underline">{legacyLabel}</a>.
        </p>
      )
    }

    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-surface2 px-5 py-2.5 text-sm font-semibold text-primary transition-colors hover:bg-border2"
    >
      Volver al inicio
    </a>
  </div>
</div>
