---
import { formatLiters, waterPct } from '../../lib/water';

/**
 * Contador del día: vaso que se llena, total y porcentaje de la meta.
 *
 * El vaso se dibuja con un div de altura variable en vez de un SVG animado:
 * el valor cambia varias veces al día y esto se actualiza con una sola
 * propiedad, sin recalcular trazados.
 */
export interface Props {
  totalMl: number;
  goalMl: number;
  isVolleyball: boolean;
}

const { totalMl, goalMl, isVolleyball } = Astro.props;
const pct = waterPct(totalMl, goalMl);
const remaining = Math.max(0, goalMl - totalMl);
---

<section class="rounded-xl border border-border2 bg-surface p-6">
  <div class="flex items-center gap-6">
    <!-- Vaso -->
    <div
      class="relative h-28 w-20 shrink-0 overflow-hidden rounded-b-2xl rounded-t-lg border-2 border-blue/40 bg-surface2"
      role="img"
      aria-label={`${pct}% de la meta de agua`}
    >
      <div
        id="water-fill"
        class="absolute inset-x-0 bottom-0 bg-blue/70 transition-[height] duration-500 ease-out"
        style={`height:${pct}%`}
      >
      </div>
      <div class="absolute inset-0 flex items-center justify-center">
        <span id="water-pct" class="font-display text-2xl text-primary drop-shadow">{pct}%</span>
      </div>
    </div>

    <div class="min-w-0 flex-1">
      <p class="text-xs uppercase tracking-wider text-muted">Hoy llevas</p>
      <p class="font-display text-4xl text-blue">
        <span id="water-total">{formatLiters(totalMl)}</span>
      </p>
      <p class="mt-1 text-sm text-muted">
        de <span id="water-goal">{formatLiters(goalMl)}</span>
        <span id="water-remaining" class="text-muted2">
          {remaining > 0 ? ` · faltan ${formatLiters(remaining)}` : ' · meta cumplida'}
        </span>
      </p>

      {
        isVolleyball && (
          <p class="mt-3 rounded-lg border border-orange/30 bg-orange/10 px-3 py-2 text-xs text-orange">
            Sábado de voleibol: la meta sube por las 4 horas de juego
            (+750 ml/hora con electrolitos).
          </p>
        )
      }
    </div>
  </div>
</section>
